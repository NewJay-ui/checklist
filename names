<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ranking</title>

<style>
*{box-sizing:border-box}
body{margin:0;padding:15px;background:#0b0b0c;color:#fff;font-family:Arial}
h1{text-align:center;margin:10px 0}
input,button{
background:#181818;color:#fff;border:0;border-radius:10px;
padding:10px;font-size:14px
}
button{cursor:pointer}
input{width:100%;margin:10px 0}

.top{display:flex;gap:8px;margin:10px 0;flex-wrap:wrap}
#t{display:grid;gap:10px}

.r{
display:flex;justify-content:space-between;align-items:center;
background:#111;padding:10px;border-radius:12px
}

.l{display:grid;gap:6px}
.n{font-weight:700}

.go{
width:44px;height:44px;padding:0;
display:grid;place-items:center;
font-size:16px
}

.c{
background:#1a1a1a;
padding:4px 10px;
border-radius:999px;
width:fit-content
}

img{
width:90px;height:90px;
object-fit:cover;
border-radius:10px;
cursor:pointer
}

/* gallery */
#x{
position:fixed;inset:0;
background:#000d;
display:none;
place-items:center;
z-index:99
}
#x img{
max-width:95%;
max-height:95%;
width:auto;height:auto
}

/* dropdown */
.menuWrap{position:relative}
#menu{
position:absolute;
top:48px;left:0;
width:280px;
background:#121212;
border-radius:14px;
padding:12px;
display:none;
z-index:50
}
#menu input{margin:6px 0}
#menu h3{margin:0 0 10px;font-size:15px}
#menu button{width:100%;margin-top:8px}

@media(max-width:600px){
img{width:75px;height:75px}
#menu{width:100%;left:0;right:0}
}
</style>
</head>
<body>

<h1>Ranking</h1>

<div class="top">

<div class="menuWrap">
<button onclick="menu.style.display=menu.style.display=='block'?'none':'block'">☰</button>

<div id="menu">
<h3>Eigenes Table hinzufügen</h3>

<input id="n1" placeholder="Name">
<input id="l1" placeholder="Mega Link">
<input id="i1" placeholder="Bild 1 URL">
<input id="i2" placeholder="Bild 2 URL">

<button onclick="addPerson()">Hinzufügen</button>
</div>
</div>

<button onclick="hide^=1;draw()">Bilder</button>
<button onclick="alt^=1;draw()">Wechsel</button>

</div>

<input id="s" placeholder="Suchen...">

<div id="t"></div>

<div id="x" onclick="x.style.display='none'">
<img id="xi">
</div>

<script>
d=[
["aaliyah yasin","https://mega.nz/folder/xUFARK7B#mCvpc18rJYr171vOA9TKvg","https://i.imgur.com/blV0wEK.jpeg"],
["annywalker","https://mega.nz/folder/q9A1VQLQ#7MHvNUDfDEgkEB_CARrEJQ","https://i.imgur.com/KG9wrc2.jpeg"],
["Comatozze","https://mega.nz/folder/hywlGJDY#dDp9Q3NFv_9cDkroIRlL4Q","https://i.imgur.com/XZyrg68.jpeg"],
