"BELLE DELPHINE":"https://i.postimg.cc/90RVXzVZ/belledelphine.jpg",
"UrFavBellaBby":"https://i.postimg.cc/1zr3bg5K/Ur-Fav-Bella-Bby.jpg",
"alina_rose":"https://i.postimg.cc/3rSdKDjk/Alina-rose.jpg",
"zoeneli":"https://i.postimg.cc/ht7JZPdz/Zoeneli.jpg",
"summerxiris":"https://i.postimg.cc/4NWbRdy2/summerxiris.jpg"
};

extra=JSON.parse(localStorage.extra||"[]");
extra.forEach(v=>{
d.push([v.name,v.link,v.img1]);
a[v.name]=v.img2;
});

k=JSON.parse(localStorage.k||"{}");
hide=0;alt=0;

function addPerson(){
name=n1.value.trim();
link=l1.value.trim();
img1=i1.value.trim();
img2=i2.value.trim();

if(!name||!link||!img1||!img2)return alert("Alles ausfüllen");

d.push([name,link,img1]);
a[name]=img2;

extra.push({name,link,img1,img2});
localStorage.extra=JSON.stringify(extra);

n1.value=l1.value=i1.value=i2.value="";
menu.style.display="none";
draw();
}

function go(name,url){
k[name]=(k[name]||0)+1;
localStorage.k=JSON.stringify(k);
draw();
window.open(url,"_blank");
}

function draw(){
t.innerHTML="";

[...d].sort((x,y)=>(k[y[0]]||0)-(k[x[0]]||0)).forEach(v=>{

if(!v[0].toLowerCase().includes(s.value.toLowerCase()))return;

name=v[0];
url=v[1];
img=alt&&a[name]?a[name]:v[2];

t.innerHTML+=`
<div class="r">
<div class="l">
<div class="n">${name}</div>
<button class="go" onclick="go('${name}','${url}')">▶</button>
<div class="c">${k[name]||0}</div>
</div>

${hide?"":`
<img src="${img}" onclick="xi.src='${img}';x.style.display='grid'">
`}

</div>`;
});
}

s.oninput=draw;
draw();
</script>

</body>
</html>
